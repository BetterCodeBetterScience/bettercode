% designchanges.sty
% Custom design modifications for "Better Code, Better Science"
% by Russell A. Poldrack
%
% This file collects all design-level customizations in one place,
% separate from the document class, per Cambridge University Press
% guidelines. Each change is documented with a brief explanation.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{designchanges}[2026/03/26 Design customizations for Better Code Better Science]

% ---------------------------------------------------------------
% List spacing: make itemize lists more compact to reduce whitespace
% ---------------------------------------------------------------
\RequirePackage{enumitem}
\setlist[itemize]{noitemsep, topsep=0pt}

% ---------------------------------------------------------------
% listings formatting
% ---------------------------------------------------------------
% \usepackage[scaled=0.85]{beramono} % A popular choice for code
\usepackage{listings}
